# Restart Vite after changing this value. It also sets the production PWA name.
VITE_APP_NAME=Athlete Lab

# Optional Phase 3A cloud connection. Both values are public browser configuration.
# Never put a service-role/secret key, database password or any API credential in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
