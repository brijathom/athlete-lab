{
  "name": "athlete-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:cloud:live": "node --env-file=.env.local scripts/verify-cloud.mjs",
    "test:coach:live": "node --env-file=.env.local scripts/verify-coach-live.mjs",
    "build:edge": "node scripts/build-edge.mjs",
    "build": "tsc --noEmit && node scripts/build-edge.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "overrides": {
    "glob": "^14.0.6"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.1.0"
  }
}
