# Server configuration template. Set credentials through Supabase Edge Function
# secrets. Routine tests use mocks and do not require an OpenAI credential.
# Never use VITE_* for any server secret or commit a populated secrets file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
COACH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.0.11:5173
COACH_HOURLY_REQUESTS=6
COACH_DAILY_REQUESTS=20
COACH_DAILY_TOKENS=500000
COACH_GLOBAL_DAILY_REQUESTS=100
COACH_GLOBAL_DAILY_TOKENS=3000000
COACH_MAX_OUTPUT_TOKENS=3000

# Direct ChatGPT tools need no OpenAI secret. Remote MCP stays disabled until
# OAuth audience/client checks and actual account eligibility are verified.
ATHLETE_APP_ORIGIN=http://localhost:5173
ATHLETE_TOOL_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.0.11:5173
ATHLETE_MCP_ENABLED=false
ATHLETE_MCP_CLIENT_IDS=
